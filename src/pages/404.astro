---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="请求的页面不存在，可以从首页、项目或实践记录继续浏览。" path="/404">
  <section class="error-page wrap">
    <p class="code">404</p>
    <h1>页面不存在</h1>
    <p class="lead" style="margin: 0 auto 2rem;">这个地址没有对应的内容。下面的入口可以继续浏览。</p>
    <div class="cta-row" style="justify-content: center;">
      <a class="button primary" href="/">返回首页</a>
      <a class="button ghost" href="/projects/">项目</a>
      <a class="button ghost" href="/notes/">实践记录</a>
    </div>
  </section>
</BaseLayout>
